from .result import issue, ok, invalid
from .types import GuardIssue, GuardResultOf, GuardRule, NumberGuard
from .utils import kind_of, is_integer, describe_value

class NumberSchema implements NumberGuard:
  private rules: GuardRule[] = []

  public constructor():
    this.rules = []
    this.int = (message: string = "") => _number_int(this, message)

  public min(size: float, message: string = "") -> NumberGuard:
    this.rules.push({ kind: "min", value: size, message: message })
    return this

  public max(size: float, message: string = "") -> NumberGuard:
    this.rules.push({ kind: "max", value: size, message: message })
    return this

  public _add_integer_rule(message: string = "") -> NumberGuard:
    this.rules.push({ kind: "int", value: 0.0, message: message })
    return this

  public positive(message: string = "") -> NumberGuard:
    this.rules.push({ kind: "positive", value: 0.0, message: message })
    return this

  public nonnegative(message: string = "") -> NumberGuard:
    this.rules.push({ kind: "nonnegative", value: 0.0, message: message })
    return this

  public multiple_of(step: float, message: string = "") -> NumberGuard:
    this.rules.push({ kind: "multiple_of", value: step, message: message })
    return this

  public validate(value: unknown, path: string = "") -> GuardResultOf<float>:
    issues: GuardIssue[] = []
    if typeof value != "number":
      issues.push(issue(path, "number", "value must be a number", "number", kind_of(value)))
      return invalid<float>(issues)
    if value != value:
      issues.push(issue(path, "number", "value must not be NaN", "number", "NaN"))
      return invalid<float>(issues)

    for rule of this.rules:
      if rule.kind == "min" and value < rule.value:
        msg = rule.message
        if msg == "":
          msg = `number must be at least ${rule.value}`
        issues.push(issue(path, "min", msg, `>= ${rule.value}`, describe_value(value)))
      else if rule.kind == "max" and value > rule.value:
        msg = rule.message
        if msg == "":
          msg = `number must be at most ${rule.value}`
        issues.push(issue(path, "max", msg, `<= ${rule.value}`, describe_value(value)))
      else if rule.kind == "int" and not is_integer(value):
        msg = rule.message
        if msg == "":
          msg = "number must be an integer"
        issues.push(issue(path, "int", msg, "integer", describe_value(value)))
      else if rule.kind == "positive" and value <= 0:
        msg = rule.message
        if msg == "":
          msg = "number must be positive"
        issues.push(issue(path, "positive", msg, "> 0", describe_value(value)))
      else if rule.kind == "nonnegative" and value < 0:
        msg = rule.message
        if msg == "":
          msg = "number must be nonnegative"
        issues.push(issue(path, "nonnegative", msg, ">= 0", describe_value(value)))
      else if rule.kind == "multiple_of":
        if rule.value == 0:
          issues.push(issue(path, "multiple_of", "multiple_of step must not be zero", "non-zero step", "0"))
        else:
          quotient = value / rule.value
          if not is_integer(quotient):
            msg = rule.message
            if msg == "":
              msg = `number must be a multiple of ${rule.value}`
            issues.push(issue(path, "multiple_of", msg, `multiple of ${rule.value}`, describe_value(value)))

    if issues.length == 0:
      return ok<float>(value)
    return invalid<float>(issues)

fn make_number() -> NumberGuard:
  return NumberSchema()

fn _number_int(schema: NumberSchema, message: string = "") -> NumberGuard:
  return schema._add_integer_rule(message)
