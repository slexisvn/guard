from .result import issue, ok, invalid
from .types import AnyGuard, EnumGuard, GuardResult, GuardSchema, LiteralGuard, NullableGuard, NullishGuard, OptionalGuard, UnionGuard
from .utils import kind_of, describe_value

class AnySchema implements AnyGuard:
  public validate(value: unknown, path: string = "") -> GuardResult:
    return ok<unknown>(value)

class LiteralSchema implements LiteralGuard:
  private expected: unknown

  public constructor(expected: unknown):
    this.expected = expected

  public validate(value: unknown, path: string = "") -> GuardResult:
    if value === this.expected:
      return ok<unknown>(value)
    return invalid<unknown>([
      issue(
        path,
        "literal",
        `value must equal ${describe_value(this.expected)}`,
        describe_value(this.expected),
        describe_value(value),
      ),
    ])

class EnumSchema implements EnumGuard:
  private values: unknown[]

  public constructor(values: unknown[]):
    this.values = values

  public validate(value: unknown, path: string = "") -> GuardResult:
    for candidate of this.values:
      if value === candidate:
        return ok<unknown>(value)
    return invalid<unknown>([
      issue(
        path,
        "one_of",
        `value must be one of ${this.values.join(", ")}`,
        this.values.join(", "),
        describe_value(value),
      ),
    ])

class UnionSchema implements UnionGuard:
  private schemas: GuardSchema[]

  public constructor(schemas: GuardSchema[]):
    this.schemas = schemas

  public validate(value: unknown, path: string = "") -> GuardResult:
    collected: string[] = []
    for schema of this.schemas:
      result = schema.validate(value, path)
      if result.ok:
        return result
      for item of result.issues:
        collected.push(item.message)
    return invalid<unknown>([
      issue(
        path,
        "union",
        `value must match one of ${this.schemas.length} schemas`,
        "union",
        kind_of(value),
      ),
    ])

class OptionalSchema implements OptionalGuard:
  private inner: GuardSchema

  public constructor(inner: GuardSchema):
    this.inner = inner

  public validate(value: unknown, path: string = "") -> GuardResult:
    if typeof value == "undefined":
      return ok<unknown>(value)
    return this.inner.validate(value, path)

class NullableSchema implements NullableGuard:
  private inner: GuardSchema

  public constructor(inner: GuardSchema):
    this.inner = inner

  public validate(value: unknown, path: string = "") -> GuardResult:
    if value === null:
      return ok<unknown>(value)
    return this.inner.validate(value, path)

class NullishSchema implements NullishGuard:
  private inner: GuardSchema

  public constructor(inner: GuardSchema):
    this.inner = inner

  public validate(value: unknown, path: string = "") -> GuardResult:
    if typeof value == "undefined":
      return ok<unknown>(value)
    if value === null:
      return ok<unknown>(value)
    return this.inner.validate(value, path)

fn make_any() -> AnyGuard:
  return AnySchema()

fn make_literal(value: unknown) -> LiteralGuard:
  return LiteralSchema(value)

fn make_one_of(values: unknown[]) -> EnumGuard:
  return EnumSchema(values)

fn make_union(schemas: GuardSchema[]) -> UnionGuard:
  return UnionSchema(schemas)

fn make_optional(schema: GuardSchema) -> OptionalGuard:
  return OptionalSchema(schema)

fn make_nullable(schema: GuardSchema) -> NullableGuard:
  return NullableSchema(schema)

fn make_nullish(schema: GuardSchema) -> NullishGuard:
  return NullishSchema(schema)
