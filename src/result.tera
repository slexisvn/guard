from .utils import label_path
from .types import GuardIssue, GuardResult, GuardResultOf, GuardSchema

fn issue(path: string, code: string, message: string, expected: string = "", received: string = "") -> GuardIssue:
  return {
    path: path,
    code: code,
    message: message,
    expected: expected,
    received: received,
  }

fn ok<T>(value: T) -> GuardResultOf<T>:
  return { ok: true, value: value, issues: [] }

fn invalid<T>(issues: GuardIssue[]) -> GuardResultOf<T>:
  return { ok: false, value: null, issues: issues }

fn from_issues<T>(value: T, issues: GuardIssue[]) -> GuardResultOf<T>:
  if issues.length == 0:
    return ok(value)
  return invalid<T>(issues)

fn validate(schema: GuardSchema, value: unknown) -> GuardResult:
  return schema.validate(value, "")

fn is_valid(schema: GuardSchema, value: unknown) -> bool:
  return validate(schema, value).ok

fn parse(schema: GuardSchema, value: unknown) -> unknown:
  result = validate(schema, value)
  if not result.ok:
    throw format_issues(result.issues)
  return result.value

fn format_issue(item: GuardIssue) -> string:
  return `${label_path(item.path)}: ${item.message}`

fn format_issues(issues: GuardIssue[]) -> string:
  lines = []
  for item of issues:
    lines.push(format_issue(item))
  return lines.join("\n")
